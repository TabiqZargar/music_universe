# Spotify API mode is optional — the app runs fully offline with demo or
# imported data when these are unset.

# Client id of your Spotify app (developer.spotify.com). Required for API mode.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Server-side client secret for the token exchange route. Optional — without
# it the PKCE public-client flow is used instead.
SPOTIFY_CLIENT_SECRET=

# Derived automatically from the deployment URL; override only if the app is
# mounted under a path or behind an unusual proxy.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# SPOTIFY_REDIRECT_URI=http://localhost:3000/callback
